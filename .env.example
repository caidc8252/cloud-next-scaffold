# Shared scaffold env

POSTGRES_DB=cloud_frontend
POSTGRES_USER=cloud
POSTGRES_PASSWORD=cloud_dev_password
POSTGRES_PORT=5433
REDIS_PORT=6379

DATABASE_URL=postgresql://cloud:cloud_dev_password@localhost:5433/cloud_frontend?schema=public
REDIS_URL=redis://localhost:6379
NEXT_PUBLIC_APP_NAME=Cloud Frontend Scaffold
PORTAL_APP_URL=http://localhost:3100
ADMIN_APP_URL=http://localhost:3000
# Production sibling subdomains can share the sid cookie, for example .example.com.
# Leave unset for localhost or when portal and admin use the same host.
# SESSION_COOKIE_DOMAIN=.example.com

# Amazon S3 upload settings. Business code reads these values and passes them to @cloud/storage/server.
# Required: target S3 bucket and AWS region.
# Business upload directories are defined by server-side upload profiles, not by client input.
AWS_S3_BUCKET=cloud-scaffold-uploads
AWS_REGION=ap-southeast-1
# Optional: custom public upload host, for example a CDN or bucket domain.
# If omitted, @cloud/storage builds https://{bucket}.s3.{region}.amazonaws.com.
# AWS_S3_UPLOAD_URL=https://cloud-scaffold-uploads.s3.ap-southeast-1.amazonaws.com

# Optional: upload guardrails in bytes.
# AWS_S3_MAX_SIZE_BYTES=1073741824
# AWS_S3_MULTIPART_THRESHOLD_BYTES=104857600
# AWS_S3_MULTIPART_PART_SIZE_BYTES=16777216

# Optional: STS session settings for browser direct uploads.
# Configure AWS_S3_UPLOAD_ROLE_ARN to use AssumeRole; otherwise the package uses GetFederationToken.
# AWS_S3_UPLOAD_ROLE_ARN=arn:aws:iam::123456789012:role/cloud-scaffold-s3-upload
# AWS_S3_UPLOAD_EXTERNAL_ID=cloud-scaffold-local
# AWS_S3_STS_DURATION_SECONDS=3600
# AWS_S3_STS_SESSION_NAME=cloud-s3-upload

# AWS credentials are required at runtime, but env vars are only one credential source.
# In production, prefer IAM role based credentials such as ECS task role, EC2 instance profile, or IRSA.
# For local development, set these when you are not using an AWS profile, SSO, or another credential provider.
# Never commit real AWS credentials.
# AWS_ACCESS_KEY_ID=replace-with-local-access-key
# AWS_SECRET_ACCESS_KEY=replace-with-local-secret-key
# AWS_SESSION_TOKEN=replace-with-local-session-token

# Optional: proxy used by server-side AWS SDK clients when local Node.js cannot reach AWS directly.
# AWS_SDK_PROXY_URL=http://127.0.0.1:53293

# 登录传输加密：dev RSA-4096 密钥对（公私钥成对，仅供本地开发）
# 私钥：服务端解密用，base64 PKCS#8 裸 DER（单行，无需 \n 转义）
AUTH_LOGIN_RSA_PRIVATE_
# 公钥：前端加密用，base64 SPKI 裸 DER（公钥 PEM 去掉头尾换行）；NEXT_PUBLIC_ 构建期内联进客户端 bundle
NEXT_PUBLIC_AUTH_LOGIN_RSA_PUBLIC_
# 登录锁定 / 时间窗（缺省即下列默认值）
AUTH_PASSWORD_MAX_ERROR_TIMES=6
AUTH_PASSWORD_LOCK_MINUTES=30
AUTH_LOGIN_TIMESTAMP_WINDOW_SECONDS=60

AUTH_AES_SECRET_KEY=lEgzf8UeLdU1/a++B1J9wgTIKZPaARu3LnyMY26MRt0=
