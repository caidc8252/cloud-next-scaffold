# next-kit e2e env template. Copy to .env.test (gitignored) and fill in.
# See skills/setup/references/e2e.md. Do NOT commit .env.test.
#
# E2E uses zero-injection local auth bypass. Playwright does not call a bypass
# API and does not write e2e/.auth/*.json; the dev server only grants DB-derived
# sessions for localhost requests, never production or CI.

# App under test = admin.
E2E_BASE_URL=http://localhost:3000
E2E_SEED=1

# Required for e2e. Do not set this on shared/public/online servers.
DEV_AUTH_BYPASS=1
DEV_AUTH_BYPASS_EMAIL=admin@newlandnpt.com

# Ephemeral test Postgres + Redis (match the host ports in e2e/docker-compose.e2e.yml;
# defaults below avoid clashing with local docker postgres/redis on 5432/5433/6379).
DATABASE_URL=postgresql://e2e:e2e@localhost:5434/e2e
# Auth needs Redis for the session store and cross-host handoff token support.
REDIS_URL=redis://localhost:6380
