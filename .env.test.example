# next-kit e2e env template. Copy to .env.test (gitignored) and fill in.
# See skills/setup/references/e2e.md. Do NOT commit .env.test.
#
# Auth is EMAIL + RSA-encrypted password, multi-step, CROSS-HOST: login lives on
# PORTAL (3100), the app under test (notice) on ADMIN (3000). global-setup signs
# in on portal then rides the session-handoff to admin (see e2e/global-setup.ts).

# App under test = admin; global-setup signs in via the portal URL.
E2E_BASE_URL=http://localhost:3000
E2E_PORTAL_URL=http://localhost:3100

# Accounts seeded behind `if (process.env.E2E_SEED)` in packages/db/prisma/seed.ts
# (test:e2e runs the seed with E2E_SEED=1). The e2e DB is ephemeral — never point
# these at accounts that exist anywhere else. Use the seed emails:
#   admin@newlandnpt.com (Administrator) / e2e-user@newlandnpt.com (non-admin)
# Only the ADMIN account is signed in today; E2E_USER_* are reserved for the
# planned non-admin `user` storageState project.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_ADMIN_EMAIL=admin@newlandnpt.com
E2E_ADMIN_PASSWORD=ChangeMe!123

# This app has no captcha; any non-empty value satisfies global-setup's check.
E2E_CAPTCHA_BYPASS_TOKEN=e2e

# Ephemeral test Postgres + Redis (match the host ports in e2e/docker-compose.e2e.yml;
# defaults below avoid clashing with local docker postgres/redis on 5432/5433/6379).
DATABASE_URL=postgresql://e2e:e2e@localhost:5434/e2e
# Login needs Redis: single-use login nonce, session store, cross-host handoff token.
REDIS_URL=redis://localhost:6380
