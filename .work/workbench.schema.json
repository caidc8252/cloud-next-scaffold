{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claude.local/.work/workbench.schema.json",
  "title": "工作台(Workbench)",
  "description": ".work/workbench.json 的结构约束。它是「唯一活跃任务锁 + 信息载体」：/start-work 写 current_task 与 start_time;/logic-analyze 写 docs_flash_time 与三个 *_docs(commit 信息);/submit-work 完成后清空(回到 {})。同一时间只允许一个活跃任务。空对象 {} 表示当前无活跃任务。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "current_task": {
      "description": "当前活跃任务信息(由真实飞书 MCP 返回,字段映射见 .claude/feishu/feishu.config.json)。无活跃任务时可缺省或为 null。",
      "type": ["object", "null"],
      "required": ["task_id", "task_name", "module", "current_owner", "current_stage"],
      "properties": {
        "task_id": {
          "type": "string",
          "description": "任务编号(如 PEP-501-01)。/start-work 入参,并用于分支名 feature/task-{task_id}。"
        },
        "task_name": {
          "type": "string",
          "description": "任务名称。"
        },
        "module": {
          "type": "object",
          "description": "归属模块,驱动资源定位(specs/prototype/data-model 路径按 category/name 拼)。",
          "required": ["category", "name"],
          "properties": {
            "category": { "type": "string", "description": "模块分类 <cat>(如 APPS)。" },
            "name": { "type": "string", "description": "模块名 <name>(如 PUBLISH)。" }
          }
        },
        "current_owner": {
          "type": "object",
          "description": "当前负责人。",
          "required": ["name", "email"],
          "properties": {
            "name": { "type": "string", "description": "负责人显示名。" },
            "email": { "type": "string", "format": "email", "description": "负责人邮箱。" }
          }
        },
        "current_stage": {
          "type": "string",
          "description": "当前阶段(飞书当前 in-progress 工作流节点名)。/start-work 检查是否等于 stage_mapping.development(开发节点 'NextJS开发(Claude)'/state_29;FE 是该节点的角色),不匹配时重点提醒操作员。"
        },
        "description": {
          "type": "string",
          "description": "任务描述。"
        }
      }
    },
    "start_time": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
      "description": "执行 /start-work 的时间(yyyy-MM-dd HH:mm:ss)。"
    },
    "docs_flash_time": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
      "description": "执行 /logic-analyze 刷新文档信息的时间(yyyy-MM-dd HH:mm:ss)。"
    },
    "specs_docs": { "$ref": "#/definitions/docRef" },
    "prototype_docs": { "$ref": "#/definitions/docRef" },
    "data_model_docs": { "$ref": "#/definitions/docRef" }
  },
  "definitions": {
    "docRef": {
      "description": "一个文档仓库的最新 git 快照信息(由 /logic-analyze 写入,用于下次增量差异比对)。无活跃任务时可缺省或为 null。",
      "type": ["object", "null"],
      "required": ["repo", "last_commit_id", "last_commit_time", "last_commit_user", "path"],
      "properties": {
        "repo": { "type": "string", "description": "远端仓库地址。" },
        "last_commit_id": { "type": "string", "description": "最后一次提交的 git commit id。" },
        "last_commit_time": { "type": "string", "description": "最后一次提交时间。" },
        "last_commit_user": { "type": "string", "description": "最后一次提交的人。" },
        "path": { "type": "string", "description": "本地路径(如 ../pep-webapp-docs)。" }
      }
    }
  }
}
