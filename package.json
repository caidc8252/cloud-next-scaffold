{
  "name": "cloud-frontend-scaffold",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "gen:manifest": "node scripts/generate-manifest-registry.mjs",
    "check:roles": "node scripts/check-preset-admin-coverage.mjs",
    "predev": "pnpm gen:manifest",
    "predev:admin": "pnpm gen:manifest",
    "predev:portal": "pnpm gen:manifest",
    "prebuild": "pnpm gen:manifest",
    "prebuild:admin": "pnpm gen:manifest",
    "prebuild:portal": "pnpm gen:manifest",
    "pretest": "pnpm gen:manifest",
    "dev": "pnpm --filter admin dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:portal": "pnpm --filter portal dev",
    "build:admin": "pnpm --filter admin build",
    "build:portal": "pnpm --filter portal build",
    "build": "pnpm db:generate && pnpm -r --filter './apps/*' build",
    "lint": "eslint apps/admin apps/portal packages/api-kit/src packages/cache/src packages/config/src packages/db packages/i18n/src packages/log/src packages/mail/src packages/permissions packages/platform-config/src packages/request/src packages/security packages/storage packages/ui/src packages/ui/docs/examples scripts/prisma.mjs eslint.config.mjs vitest.config.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:push": "node scripts/prisma.mjs db push",
    "db:seed": "node scripts/prisma.mjs db seed",
    "db:seed:portal-login-tests": "pnpm --filter @cloud/db seed:portal-login-tests",
    "db:studio": "node scripts/prisma.mjs studio",
    "db:setup": "pnpm db:generate && pnpm db:push && pnpm db:seed",
    "check:diff-coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=html && node scripts/check-diff-coverage.mjs",
    "test:e2e": "pnpm test:e2e:spec && pnpm check:e2e-orphans",
    "test:e2e:spec": "docker compose -f e2e/docker-compose.e2e.yml up -d --wait postgres-e2e redis-e2e && node --env-file=.env.test scripts/prisma.mjs db push && E2E_SEED=1 node --env-file=.env.test scripts/prisma.mjs db seed && playwright test",
    "check:e2e-orphans": "E2E_MARKER_ROOTS='apps/*/src apps/*/app apps/*/middleware.ts' node scripts/check-e2e-orphans.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@tailwindcss/postcss": "^4.1.16",
    "@vitejs/plugin-react": "^5.1.0",
    "dotenv": "^16.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^27.2.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.16",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.6",
    "@vitest/coverage-v8": "^4.1.0",
    "@playwright/test": "^1.49.0",
    "pg": "^8.13.0",
    "@types/pg": "^8.11.10",
    "typescript-eslint": "^8.0.0"
  }
}
