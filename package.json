{
  "name": "cloud-frontend-scaffold",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "gen:manifest": "node scripts/generate-manifest-registry.mjs",
    "predev": "pnpm gen:manifest",
    "predev:web": "pnpm gen:manifest",
    "prebuild": "pnpm gen:manifest",
    "prebuild:web": "pnpm gen:manifest",
    "pretest": "pnpm gen:manifest",
    "dev": "pnpm --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "build": "pnpm db:generate && pnpm -r --filter './apps/*' build",
    "lint": "eslint apps/web packages/cache/src packages/config/src packages/db packages/i18n/src packages/permissions packages/platform-config/src packages/request/src packages/security packages/storage packages/ui/src scripts/prisma.mjs eslint.config.mjs vitest.config.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:push": "node scripts/prisma.mjs db push",
    "db:seed": "node scripts/prisma.mjs db seed",
    "db:studio": "node scripts/prisma.mjs studio",
    "db:setup": "pnpm db:generate && pnpm db:push && pnpm db:seed"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@tailwindcss/postcss": "^4.1.16",
    "@vitejs/plugin-react": "^5.1.0",
    "dotenv": "^16.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^27.2.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.16",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.6"
  }
}
