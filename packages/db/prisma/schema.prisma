generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── sys_partner ─────────────────────────────────────────
model SysPartner {
  partnerId         Int      @id @default(autoincrement()) @map("partner_id")
  partnerName       String   @map("partner_name") @db.VarChar(200)
  country          String   @db.VarChar(8)
  region           String?  @db.VarChar(100)
  address          String?  @db.VarChar(500)
  phoneCountryCode String?  @map("phone_country_code") @db.VarChar(8)
  phone            String?  @db.VarChar(32)
  email            String?
  contactName      String?  @map("contact_name") @db.VarChar(100)
  status           String   @default("ACTIVE") @db.VarChar(20)
  remark           String?  @db.VarChar(500)
  timezone         String?  @db.VarChar(64)
  license          String?  @db.VarChar(200)
  creTime          DateTime @default(now()) @map("cre_time") @db.Timestamp(3)
  creUserId        Int      @default(0) @map("cre_user_id")
  updTime          DateTime @default(now()) @updatedAt @map("upd_time") @db.Timestamp(3)
  updUserId        Int      @default(0) @map("upd_user_id")

  contracts        SysPartnerContract[] @relation("authorized")
  grantedContracts SysPartnerContract[] @relation("authorizing")
  ownerRelations   SysPartnerPartner[]   @relation("owner")
  targetRelations  SysPartnerPartner[]   @relation("target")
  partnerUsers      SysPartnerUser[]
  roles            SysRole[]
  userRoles        SysUserRole[]
  orgs             SysOrg[]
  roleBlacklists   SysRoleContractBlacklist[]
  storageObjects     StorageObject[]
  storageAttachments StorageAttachment[]

  @@index([partnerName], map: "idx_sys_partner_name")
  @@index([country], map: "idx_sys_partner_country")
  @@index([status], map: "idx_sys_partner_status")
  @@map("sys_partner")
}

// ─── sys_contract_define ────────────────────────────────
model SysContractDefine {
  contractDefineCode String   @id @map("contract_define_code") @db.VarChar(20)
  contractName       String   @map("contract_name") @db.VarChar(100)
  remark             String?  @db.VarChar(500)
  creTime            DateTime @default(now()) @map("cre_time") @db.Timestamp(3)
  creUserId          Int      @default(0) @map("cre_user_id")
  updTime            DateTime @default(now()) @updatedAt @map("upd_time") @db.Timestamp(3)
  updUserId          Int      @default(0) @map("upd_user_id")

  partnerContracts SysPartnerContract[]
  roles           SysRole[]
  roleBlacklists  SysRoleContractBlacklist[]

  @@map("sys_contract_define")
}

// ─── sys_partner_partner ──────────────────────────────────
model SysPartnerPartner {
  partnerPartnerId Int      @id @default(autoincrement()) @map("partner_partner_id")
  ownerPartnerId  Int      @map("owner_partner_id")
  targetPartnerId Int      @map("target_partner_id")
  status         String   @default("ACTIVE") @db.VarChar(20)
  creTime        DateTime @default(now()) @map("cre_time") @db.Timestamp(3)

  owner  SysPartner @relation("owner", fields: [ownerPartnerId], references: [partnerId])
  target SysPartner @relation("target", fields: [targetPartnerId], references: [partnerId])

  @@unique([ownerPartnerId, targetPartnerId], map: "uk_sys_partner_partner")
  @@index([targetPartnerId])
  @@map("sys_partner_partner")
}

// ─── sys_partner_contract ────────────────────────────────
model SysPartnerContract {
  partnerContractId             Int       @id @default(autoincrement()) @map("partner_contract_id")
  authorizedPartnerId           Int       @map("authorized_partner_id")
  authorizedContractDefineCode String    @map("authorized_contract_define_code") @db.VarChar(20)
  authorizedTimestamp           DateTime? @map("authorized_timestamp") @db.Timestamp(3)
  authorizingPartnerId          Int?      @map("authorizing_partner_id")
  authorizingUserId            Int?      @map("authorizing_user_id")
  authorizingUserName          String?   @map("authorizing_user_name") @db.VarChar(100)
  authorizingIp                String?   @map("authorizing_ip")
  status                       String    @default("PENDING") @db.VarChar(20)
  effectiveFrom                DateTime? @map("effective_from") @db.Timestamp(3)
  effectiveTo                  DateTime? @map("effective_to") @db.Timestamp(3)
  renewalMethod                String?   @map("renewal_method") @db.VarChar(30)
  terminatedAt                 DateTime? @map("terminated_at") @db.Timestamp(3)
  creTime                      DateTime  @default(now()) @map("cre_time") @db.Timestamp(3)
  creUserId                    Int       @default(0) @map("cre_user_id")
  updTime                      DateTime  @default(now()) @updatedAt @map("upd_time") @db.Timestamp(3)
  updUserId                    Int       @default(0) @map("upd_user_id")

  authorizedPartner  SysPartner         @relation("authorized", fields: [authorizedPartnerId], references: [partnerId])
  authorizingPartner SysPartner?        @relation("authorizing", fields: [authorizingPartnerId], references: [partnerId])
  contractDefine    SysContractDefine @relation(fields: [authorizedContractDefineCode], references: [contractDefineCode])

  @@index([authorizedPartnerId])
  @@index([authorizedContractDefineCode])
  @@index([authorizingPartnerId])
  @@index([authorizedPartnerId, status])
  @@map("sys_partner_contract")
}

// ─── sys_role ───────────────────────────────────────────
model SysRole {
  roleId             Int      @id @default(autoincrement()) @map("role_id")
  roleName           String   @map("role_name") @db.VarChar(100)
  roleType           String   @map("role_type") @db.VarChar(20)
  contractDefineCode String?  @map("contract_define_code") @db.VarChar(20)
  partnerId           Int?     @map("partner_id")
  remark             String?  @db.VarChar(500)
  creTime            DateTime @default(now()) @map("cre_time") @db.Timestamp(3)
  creUserId          Int      @default(0) @map("cre_user_id")
  updTime            DateTime @default(now()) @updatedAt @map("upd_time") @db.Timestamp(3)
  updUserId          Int      @default(0) @map("upd_user_id")

  contractDefine SysContractDefine?        @relation(fields: [contractDefineCode], references: [contractDefineCode])
  partner         SysPartner?                @relation(fields: [partnerId], references: [partnerId])
  permissions    SysRolePermission[]
  userRoles      SysUserRole[]
  roleBlacklists SysRoleContractBlacklist[]

  @@index([partnerId])
  @@index([contractDefineCode])
  @@index([roleName])
  @@map("sys_role")
}

// ─── sys_role_permission ────────────────────────────────
model SysRolePermission {
  rolePermissionId Int      @id @default(autoincrement()) @map("role_permission_id")
  roleId           Int      @map("role_id")
  permissionCode   String   @map("permission_code") @db.VarChar(100)
  creTime          DateTime @default(now()) @map("cre_time") @db.Timestamp(3)
  creUserId        Int      @default(0) @map("cre_user_id")
  updTime          DateTime @default(now()) @updatedAt @map("upd_time") @db.Timestamp(3)
  updUserId        Int      @default(0) @map("upd_user_id")

  role SysRole @relation(fields: [roleId], references: [roleId], onDelete: Cascade)

  // permissionCode 是受 manifest 校验的普通字符串（不再外键到 sys_permission）
  @@unique([roleId, permissionCode], map: "uk_sys_role_permission")
  @@index([permissionCode])
  @@map("sys_role_permission")
}

// ─── sys_role_contract_blacklist ────────────────────────
model SysRoleContractBlacklist {
  roleContractBlacklistId Int      @id @default(autoincrement()) @map("role_contract_blacklist_id")
  roleId                  Int      @map("role_id")
  contractDefineCode      String   @map("contract_define_code") @db.VarChar(20)
  partnerId                Int      @map("partner_id")
  creTime                 DateTime @default(now()) @map("cre_time") @db.Timestamp(3)
  creUserId               Int      @default(0) @map("cre_user_id")

  role           SysRole           @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  contractDefine SysContractDefine @relation(fields: [contractDefineCode], references: [contractDefineCode])
  partner         SysPartner         @relation(fields: [partnerId], references: [partnerId])

  @@unique([roleId, contractDefineCode, partnerId], map: "uk_sys_role_contract_blacklist")
  @@index([partnerId])
  @@index([contractDefineCode])
  @@map("sys_role_contract_blacklist")
}

// ─── sys_user ───────────────────────────────────────────
model SysUser {
  userId                           Int       @id @default(autoincrement()) @map("user_id")
  username                         String?   @unique
  passwordHash                     String    @map("password_hash") @db.VarChar(255)
  passwordChangedTimestamp         DateTime? @map("password_changed_timestamp") @db.Timestamp(3)
  passwordErrorTimes               Int       @default(0) @map("password_error_times")
  passwordErrorLockExpiredTimestamp DateTime? @map("password_error_lock_expired_timestamp") @db.Timestamp(3)
  displayName                      String?   @map("display_name") @db.VarChar(100)
  email                            String?
  country                          String?   @db.VarChar(8)
  status                           String    @default("ACTIVE") @db.VarChar(20)
  mfaEnabled                       Boolean   @default(false) @map("mfa_enabled")
  lastLoginAt                      DateTime? @map("last_login_at") @db.Timestamp(3)
  passwordUpdatedAt                DateTime? @map("password_updated_at") @db.Timestamp(3)
  remark                           String?   @db.VarChar(500)
  creTime                          DateTime  @default(now()) @map("cre_time") @db.Timestamp(3)
  creUserId                        Int       @default(0) @map("cre_user_id")
  updTime                          DateTime  @default(now()) @updatedAt @map("upd_time") @db.Timestamp(3)
  updUserId                        Int       @default(0) @map("upd_user_id")

  partnerUsers           SysPartnerUser[]
  userRoles             SysUserRole[]
  passwordHistory       SysUserPasswordHistory[]
  userOrgs              SysUserOrg[]
  invites               SysInvite[]
  passwordResetRequests SysPasswordResetRequest[]
  uploadedStorageObjects StorageObject[]

  @@index([status])
  @@map("sys_user")
}

// ─── sys_user_password_history ──────────────────────────
model SysUserPasswordHistory {
  userPasswordHistoryId String    @id @default(uuid()) @map("user_password_history_id")
  userId                Int       @map("user_id")
  passwordHash          String    @map("password_hash") @db.VarChar(255)
  creTime               DateTime  @default(now()) @map("cre_time") @db.Timestamp(3)
  changedTimestamp       DateTime? @map("changed_timestamp") @db.Timestamp(3)

  user SysUser @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, creTime(sort: Desc)])
  @@map("sys_user_password_history")
}

// ─── sys_user_role ──────────────────────────────────────
model SysUserRole {
  userRoleId Int      @id @default(autoincrement()) @map("user_role_id")
  partnerId   Int      @map("partner_id")
  userId     Int      @map("user_id")
  roleId     Int      @map("role_id")
  creTime    DateTime @default(now()) @map("cre_time") @db.Timestamp(3)
  creUserId  Int      @default(0) @map("cre_user_id")
  updTime    DateTime @default(now()) @updatedAt @map("upd_time") @db.Timestamp(3)
  updUserId  Int      @default(0) @map("upd_user_id")

  partner SysPartner @relation(fields: [partnerId], references: [partnerId])
  user   SysUser   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  role   SysRole   @relation(fields: [roleId], references: [roleId])

  @@unique([partnerId, userId, roleId], map: "uk_sys_user_role")
  @@index([userId, partnerId])
  @@index([roleId])
  @@index([partnerId])
  @@map("sys_user_role")
}

// ─── sys_partner_user ────────────────────────────────────
model SysPartnerUser {
  partnerUserId        Int       @id @default(autoincrement()) @map("partner_user_id")
  partnerId            Int       @map("partner_id")
  userId              Int       @map("user_id")
  authorizingType     String    @default("NORMAL") @map("authorizing_type") @db.VarChar(20)
  authorizingTimestamp DateTime? @map("authorizing_timestamp") @db.Timestamp(3)
  authorizingUserId   Int?      @map("authorizing_user_id")
  authorizingUserName String?   @map("authorizing_user_name") @db.VarChar(100)
  status              String    @default("ACTIVE") @db.VarChar(20)
  creTime             DateTime  @default(now()) @map("cre_time") @db.Timestamp(3)
  creUserId           Int       @default(0) @map("cre_user_id")
  updTime             DateTime  @default(now()) @updatedAt @map("upd_time") @db.Timestamp(3)
  updUserId           Int       @default(0) @map("upd_user_id")

  partner SysPartner @relation(fields: [partnerId], references: [partnerId])
  user   SysUser   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([partnerId, userId], map: "uk_sys_partner_user")
  @@index([userId])
  @@index([partnerId, status])
  @@map("sys_partner_user")
}

// 菜单与权限定义不再入库，改由各 apps/*/manifest + @cloud/platform-config 提供。
// sys_menu / sys_permission / sys_user_permission_scope 已移除。

// ─── sys_org ────────────────────────────────────────────
model SysOrg {
  orgId       Int     @id @default(autoincrement()) @map("org_id")
  partnerId    Int     @map("partner_id")
  orgName     String  @map("org_name") @db.VarChar(200)
  parentOrgId Int     @default(0) @map("parent_org_id")
  country     String? @db.VarChar(8)
  address     String? @db.VarChar(500)
  phone       String? @db.VarChar(32)

  partner   SysPartner  @relation(fields: [partnerId], references: [partnerId])
  userOrgs SysUserOrg[]

  @@index([partnerId])
  @@index([parentOrgId])
  @@index([partnerId, parentOrgId])
  @@map("sys_org")
}

// ─── sys_user_org ───────────────────────────────────────
model SysUserOrg {
  userOrgId Int @id @default(autoincrement()) @map("user_org_id")
  userId    Int @map("user_id")
  orgId     Int @map("org_id")

  user SysUser @relation(fields: [userId], references: [userId], onDelete: Cascade)
  org  SysOrg  @relation(fields: [orgId], references: [orgId], onDelete: Cascade)

  @@unique([userId, orgId], map: "uk_sys_user_org")
  @@index([orgId])
  @@map("sys_user_org")
}

// ─── sys_invite ────────────────────────────────────────
model SysInvite {
  inviteId   Int       @id @default(autoincrement()) @map("invite_id")
  userId     Int       @map("user_id")
  email      String    @db.VarChar(200)
  token      String    @unique @db.VarChar(100)
  expiresAt  DateTime  @map("expires_at") @db.Timestamp(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamp(3)
  status     String    @default("PENDING") @db.VarChar(20)
  creTime    DateTime  @default(now()) @map("cre_time") @db.Timestamp(3)
  creUserId   Int       @default(0) @map("cre_user_id")
  resendCount Int       @default(0) @map("resend_count")
  updTime     DateTime  @default(now()) @updatedAt @map("upd_time") @db.Timestamp(3)

  user SysUser @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("sys_invite")
}

// ─── sys_password_reset_request ────────────────────────
model SysPasswordResetRequest {
  requestId  Int       @id @default(autoincrement()) @map("request_id")
  userId     Int       @map("user_id")
  token      String    @unique @db.VarChar(100)
  expiresAt  DateTime  @map("expires_at") @db.Timestamp(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamp(3)
  status     String    @default("PENDING") @db.VarChar(20)
  creTime    DateTime  @default(now()) @map("cre_time") @db.Timestamp(3)
  creUserId  Int       @default(0) @map("cre_user_id")
  updTime    DateTime  @default(now()) @updatedAt @map("upd_time") @db.Timestamp(3)

  user SysUser @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("sys_password_reset_request")
}

// ─── storage_object ─────────────────────────────────────
model StorageObject {
  storageObjectId  String    @id @default(uuid()) @map("storage_object_id")
  partnerId         Int       @map("partner_id")
  uploaderUserId   Int       @map("uploader_user_id")
  bucket           String    @db.VarChar(255)
  regionId         String    @map("region_id") @db.VarChar(64)
  objectKey        String    @map("object_key") @db.VarChar(1024)
  objectUrl        String    @map("object_url") @db.VarChar(1200)
  originalFilename String    @map("original_filename") @db.VarChar(255)
  contentType      String    @map("content_type") @db.VarChar(255)
  sizeBytes        BigInt    @map("size_bytes")
  contentHash      String?   @map("content_hash") @db.VarChar(64)
  visibility       String    @default("PRIVATE") @db.VarChar(20)
  etag             String?   @db.VarChar(255)
  status           String    @default("ACTIVE") @db.VarChar(20)
  creTime          DateTime  @default(now()) @map("cre_time") @db.Timestamp(3)
  creUserId        Int       @default(0) @map("cre_user_id")
  updTime          DateTime  @default(now()) @updatedAt @map("upd_time") @db.Timestamp(3)
  updUserId        Int       @default(0) @map("upd_user_id")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamp(3)

  partner      SysPartner           @relation(fields: [partnerId], references: [partnerId])
  uploader    SysUser             @relation(fields: [uploaderUserId], references: [userId])
  attachments StorageAttachment[]

  @@unique([partnerId, bucket, objectKey], map: "uk_storage_object_partner_bucket_key")
  @@index([partnerId, contentHash, sizeBytes, status], map: "idx_storage_object_partner_hash_size_status")
  @@index([partnerId, status, creTime(sort: Desc)], map: "idx_storage_object_partner_status_time")
  @@index([uploaderUserId], map: "idx_storage_object_uploader")
  @@map("storage_object")
}

// ─── storage_attachment ─────────────────────────────────
model StorageAttachment {
  storageAttachmentId String    @id @default(uuid()) @map("storage_attachment_id")
  partnerId            Int       @map("partner_id")
  storageObjectId     String    @map("storage_object_id")
  subjectType         String    @map("subject_type") @db.VarChar(64)
  subjectId           String    @map("subject_id") @db.VarChar(128)
  purpose             String    @db.VarChar(64)
  displayName         String?   @map("display_name") @db.VarChar(255)
  sortNo              Int       @default(0) @map("sort_no")
  isPrimary           Boolean   @default(false) @map("is_primary")
  status              String    @default("ACTIVE") @db.VarChar(20)
  creTime             DateTime  @default(now()) @map("cre_time") @db.Timestamp(3)
  creUserId           Int       @default(0) @map("cre_user_id")
  updTime             DateTime  @default(now()) @updatedAt @map("upd_time") @db.Timestamp(3)
  updUserId           Int       @default(0) @map("upd_user_id")
  deletedAt           DateTime? @map("deleted_at") @db.Timestamp(3)

  partner        SysPartner     @relation(fields: [partnerId], references: [partnerId])
  storageObject StorageObject @relation(fields: [storageObjectId], references: [storageObjectId], onDelete: Cascade)

  @@unique([partnerId, storageObjectId, subjectType, subjectId, purpose], map: "uk_storage_attachment_object_subject")
  @@index([partnerId, subjectType, subjectId, purpose, status, sortNo], map: "idx_storage_attachment_subject")
  @@index([storageObjectId], map: "idx_storage_attachment_object")
  @@index([partnerId, status, creTime(sort: Desc)], map: "idx_storage_attachment_partner_status_time")
  @@map("storage_attachment")
}
