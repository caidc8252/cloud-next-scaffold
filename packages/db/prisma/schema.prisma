generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

// 说明（对齐系统 DB 脚本 Partner/Contract/Role/User/MFA/Invite）：
// - 角色/权限关联用 JSONB 数组（sys_party_user.roles / sys_role.permission_codes），
//   是 DB 约定「关联走关联表」的已批准例外，理由是反查频率低、读多写少，详见 CLAUDE.md。
// - 契约类型为内联字符串枚举（应用层 zod 校验），不再有 sys_contract_define 表。
// - CHECK / partial unique index / 触发器等 Prisma 表达不了的硬约束，统一由应用层（zod +
//   service 事务）保证；upd_time 走 @updatedAt。详见 DEV_NOTE。

// ─── sys_party ─────────────────────────────────────────
model SysParty {
  partyId        Int      @id @default(autoincrement()) @map("party_id")
  partyName      String   @unique @map("party_name") @db.VarChar(200)
  country          String   @db.VarChar(8)
  address          String?  @db.VarChar(500)
  contactName      String?  @map("contact_name") @db.VarChar(100)
  email            String?  @db.Citext
  callingCode      String?  @map("calling_code") @db.VarChar(8)
  phone            String?  @db.VarChar(32)
  timezone         String   @db.VarChar(64)
  license          String?  @db.VarChar(200)
  status           String   @default("ONBOARDING") @db.VarChar(20)
  remark           String?  @db.VarChar(500)
  creTime          DateTime @default(now()) @map("cre_time") @db.Timestamp(3)
  creUserId        Int      @default(0) @map("cre_user_id")
  updTime          DateTime @default(now()) @updatedAt @map("upd_time") @db.Timestamp(3)
  updUserId        Int      @default(0) @map("upd_user_id")

  contracts            SysPartyContract[] @relation("authorized")
  grantedContracts     SysPartyContract[] @relation("authorizing")
  terminatedContracts  SysPartyContract[] @relation("terminatedBy")
  partyUsers         SysPartyUser[]
  roles                SysRole[]
  operatorInvites      SysOperatorInvite[] @relation("invitedParty")
  invitesSentFromParty SysOperatorInvite[] @relation("inviterParty")
  storageObjects       StorageObject[]
  storageAttachments   StorageAttachment[]
  notices              SysNotice[]

  @@index([country], map: "idx_sys_party_country")
  @@index([status], map: "idx_sys_party_status")
  @@map("sys_party")
}

// ─── sys_party_contract ────────────────────────────────
model SysPartyContract {
  partyContractId              Int       @id @default(autoincrement()) @map("party_contract_id")
  authorizedPartyId            Int       @map("authorized_party_id")
  authorizedContractType         String    @map("authorized_contract_type") @db.VarChar(20)
  authorizedTimestamp            DateTime? @map("authorized_timestamp") @db.Timestamp(3)
  authorizingPartyId           Int?      @map("authorizing_party_id")
  authorizingPartyContractType String?   @map("authorizing_party_contract_type") @db.VarChar(20)
  effectiveFromDate              DateTime? @map("effective_from_date") @db.Date
  effectiveToDate                DateTime? @map("effective_to_date") @db.Date
  terminatedByPartyId          Int?      @map("terminated_by_party_id")
  terminatedAt                   DateTime? @map("terminated_at") @db.Timestamp(3)
  status                         String    @default("ACTIVE") @db.VarChar(20)
  entitlements                   Json?
  logos                          Json?
  creTime                        DateTime  @default(now()) @map("cre_time") @db.Timestamp(3)
  creUserId                      Int       @default(0) @map("cre_user_id")
  updTime                        DateTime  @default(now()) @updatedAt @map("upd_time") @db.Timestamp(3)
  updUserId                      Int       @default(0) @map("upd_user_id")

  authorizedPartner  SysParty  @relation("authorized", fields: [authorizedPartyId], references: [partyId])
  authorizingPartner SysParty? @relation("authorizing", fields: [authorizingPartyId], references: [partyId])
  terminatedByPartner SysParty? @relation("terminatedBy", fields: [terminatedByPartyId], references: [partyId])
  events             SysPartyContractEvent[]

  @@index([authorizedPartyId])
  @@index([authorizedContractType])
  @@index([authorizingPartyId])
  @@index([authorizedPartyId, status])
  @@map("sys_party_contract")
}

// ─── sys_party_contract_event（契约事件流水，UUID 主键）──
model SysPartyContractEvent {
  partyContractEventId String   @id @default(uuid()) @map("party_contract_event_id")
  partyContractId      Int      @map("party_contract_id")
  // eventType 取值（闭集，写入点用 zod 约束；Prisma 不表达 CHECK，DDL 层 CHECK 见 pep-schema）：
  // CREATE_CONTRACT / EDIT_CONTRACT / RENEW / SUSPEND / RESUME / TERMINATE / PILOT_CONVERT_ACTIVE
  eventType              String   @map("event_type") @db.VarChar(40)
  // payload 按 eventType 分型（详见 domain-model.md「Event payload」）；尚无写入点。
  payload                Json?    @map("payload")
  eventTimestamp         DateTime @default(now()) @map("event_timestamp") @db.Timestamp(3)
  operatorUserId         Int?     @map("operator_user_id")
  operatorUserName       String?  @map("operator_user_name") @db.VarChar(100)
  creTime                DateTime @default(now()) @map("cre_time") @db.Timestamp(3)

  partyContract SysPartyContract @relation(fields: [partyContractId], references: [partyContractId], onDelete: Cascade)

  @@index([partyContractId, eventTimestamp(sort: Desc)])
  @@index([eventType])
  @@map("sys_party_contract_event")
}

// ─── sys_role ───────────────────────────────────────────
model SysRole {
  roleId          Int      @id @default(autoincrement()) @map("role_id")
  roleName        String   @map("role_name") @db.VarChar(100)
  roleType        String   @map("role_type") @db.VarChar(20)
  partyId       Int?     @map("party_id")
  // 角色授权窗（DATE，按 party.timezone 解读为该日 0 秒 / 最后一秒）；NULL = 无界。仅 PRIVATE 角色用。
  startDate       DateTime? @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  permissionCodes Json     @default("[]") @map("permission_codes")
  remark          String?  @db.VarChar(500)
  creTime         DateTime @default(now()) @map("cre_time") @db.Timestamp(3)
  creUserId       Int      @default(0) @map("cre_user_id")
  updTime         DateTime @default(now()) @updatedAt @map("upd_time") @db.Timestamp(3)
  updUserId       Int      @default(0) @map("upd_user_id")

  partner        SysParty?               @relation(fields: [partyId], references: [partyId])

  @@index([partyId])
  @@index([roleName])
  @@map("sys_role")
}

// ─── sys_user ───────────────────────────────────────────
model SysUser {
  userId                            Int       @id @default(autoincrement()) @map("user_id")
  passwordHash                      String    @map("password_hash") @db.VarChar(255)
  passwordChangedTimestamp          DateTime? @map("password_changed_timestamp") @db.Timestamp(3)
  passwordErrorTimes                Int       @default(0) @map("password_error_times")
  passwordErrorLockExpiredTimestamp DateTime? @map("password_error_lock_expired_timestamp") @db.Timestamp(3)
  nickName                          String    @map("nick_name") @db.VarChar(100)
  email                             String    @unique @db.Citext
  country                           String?   @db.VarChar(8)
  locale                            String    @default("en") @db.VarChar(35)
  callingCode                       String?   @map("calling_code") @db.VarChar(8)
  phone                             String?   @db.VarChar(32)
  mfaEnable                         Boolean   @default(false) @map("mfa_enable")
  status                            String    @default("ACTIVE") @db.VarChar(20)
  lastLoginAt                       DateTime? @map("last_login_at") @db.Timestamp(3)
  passwordHistory                   Json      @default("[]") @map("password_history")
  creTime                           DateTime  @default(now()) @map("cre_time") @db.Timestamp(3)
  creUserId                         Int       @default(0) @map("cre_user_id")
  updTime                           DateTime  @default(now()) @updatedAt @map("upd_time") @db.Timestamp(3)
  updUserId                         Int       @default(0) @map("upd_user_id")

  partyUsers           SysPartyUser[]
  mfaInfos               SysMfaInfo[]
  sentInvites            SysOperatorInvite[]
  uploadedStorageObjects StorageObject[]
  notices                SysNotice[]

  @@index([email])
  @@index([status])
  @@map("sys_user")
}

// ─── sys_mfa_info（MFA 配置：TOTP 因子）──
// 刻意不加 (userId, mfaType) 唯一约束：Reconfigure 需要"建新记录(PENDING)→激活后删旧"
// 的过渡期里同 (userId, TOTP) 暂存 1 ACTIVE + 1 PENDING。"稳态 ≤1 ACTIVE、≤1 PENDING"
// 这条不变量改由 service 层 + 事务保证（沿用本仓"Prisma 表达不了的约束走应用层"约定）。
model SysMfaInfo {
  mfaInfoId         Int       @id @default(autoincrement()) @map("mfa_info_id")
  userId            Int       @map("user_id")
  mfaType           String    @default("TOTP") @map("mfa_type") @db.VarChar(20)
  secretEncrypted   String    @map("secret_encrypted") @db.VarChar(500)
  failTimes         Int       @default(0) @map("fail_times")
  lastFailTimestamp DateTime? @map("last_fail_timestamp") @db.Timestamp(3)
  status            String    @default("PENDING") @db.VarChar(20)
  creTime           DateTime  @default(now()) @map("cre_time") @db.Timestamp(3)
  creUserId         Int       @default(0) @map("cre_user_id")
  updTime           DateTime  @default(now()) @updatedAt @map("upd_time") @db.Timestamp(3)
  updUserId         Int       @default(0) @map("upd_user_id")

  user SysUser @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@map("sys_mfa_info")
}

// ─── sys_party_user（用户与主体的归属/授权关系）────────
model SysPartyUser {
  partyUserId        Int       @id @default(autoincrement()) @map("party_user_id")
  partyId            Int       @map("party_id")
  userId               Int       @map("user_id")
  roles                Json      @default("[]")
  authorizingType      String    @default("NORMAL") @map("authorizing_type") @db.VarChar(20)
  authorizingTimestamp DateTime? @map("authorizing_timestamp") @db.Timestamp(3)
  authorizingUserId    Int?      @map("authorizing_user_id")
  authorizingUserName  String?   @map("authorizing_user_name") @db.VarChar(100)
  status               String    @default("ACTIVE") @db.VarChar(20)
  remark               String?   @db.VarChar(500)
  authorizingFrom      DateTime? @map("authorizing_from") @db.Timestamp(3)
  authorizingTo        DateTime? @map("authorizing_to") @db.Timestamp(3)
  creTime              DateTime  @default(now()) @map("cre_time") @db.Timestamp(3)
  creUserId            Int       @default(0) @map("cre_user_id")
  updTime              DateTime  @default(now()) @updatedAt @map("upd_time") @db.Timestamp(3)
  updUserId            Int       @default(0) @map("upd_user_id")

  partner SysParty @relation(fields: [partyId], references: [partyId])
  user    SysUser    @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([partyId, userId], map: "uk_sys_party_user")
  @@index([userId])
  @@index([partyId, status])
  @@map("sys_party_user")
}

// ─── sys_operator_invite（操作员邀请入驻）────────────────
model SysOperatorInvite {
  operatorInviteId Int       @id @default(autoincrement()) @map("operator_invite_id")
  partyId        Int       @map("party_id")
  inviterPartyId   Int       @map("inviter_party_id")
  inviterUserId    Int       @map("inviter_user_id")
  inviteEmail      String    @map("invite_email") @db.Citext
  intendedRole     Json      @default("[]") @map("intended_role")
  token            String    @unique @db.VarChar(128)
  expiresAt        DateTime  @map("expires_at") @db.Timestamp(3)
  consumedAt       DateTime? @map("consumed_at") @db.Timestamp(3)
  resendCount      Int       @default(0) @map("resend_count")
  status           String    @default("PENDING") @db.VarChar(20)
  creTime          DateTime  @default(now()) @map("cre_time") @db.Timestamp(3)
  creUserId        Int       @default(0) @map("cre_user_id")
  updTime          DateTime  @default(now()) @updatedAt @map("upd_time") @db.Timestamp(3)
  updUserId        Int       @default(0) @map("upd_user_id")

  // 被邀请入驻的主体（party 删除则级联清理其邀请）。
  partner      SysParty @relation("invitedParty", fields: [partyId], references: [partyId], onDelete: Cascade)
  // 邀请者所属主体（仅引用，不级联）。
  inviterParty SysParty @relation("inviterParty", fields: [inviterPartyId], references: [partyId])
  inviter      SysUser  @relation(fields: [inviterUserId], references: [userId])

  @@index([partyId])
  @@index([inviterPartyId])
  @@index([inviteEmail])
  @@map("sys_operator_invite")
}

// 菜单与权限定义不入库，由各 apps/*/manifest + @cloud/platform-config 提供。

// ─── storage_object ─────────────────────────────────────
model StorageObject {
  storageObjectId  String    @id @default(uuid()) @map("storage_object_id")
  partyId         Int       @map("party_id")
  uploaderUserId   Int       @map("uploader_user_id")
  bucket           String    @db.VarChar(255)
  regionId         String    @map("region_id") @db.VarChar(64)
  objectKey        String    @map("object_key") @db.VarChar(1024)
  objectUrl        String    @map("object_url") @db.VarChar(1200)
  originalFilename String    @map("original_filename") @db.VarChar(255)
  contentType      String    @map("content_type") @db.VarChar(255)
  sizeBytes        BigInt    @map("size_bytes")
  contentHash      String?   @map("content_hash") @db.VarChar(64)
  visibility       String    @default("PRIVATE") @db.VarChar(20)
  etag             String?   @db.VarChar(255)
  status           String    @default("ACTIVE") @db.VarChar(20)
  creTime          DateTime  @default(now()) @map("cre_time") @db.Timestamp(3)
  creUserId        Int       @default(0) @map("cre_user_id")
  updTime          DateTime  @default(now()) @updatedAt @map("upd_time") @db.Timestamp(3)
  updUserId        Int       @default(0) @map("upd_user_id")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamp(3)

  partner      SysParty           @relation(fields: [partyId], references: [partyId])
  uploader    SysUser             @relation(fields: [uploaderUserId], references: [userId])
  attachments StorageAttachment[]

  @@unique([partyId, bucket, objectKey], map: "uk_storage_object_partner_bucket_key")
  @@index([partyId, contentHash, sizeBytes, status], map: "idx_storage_object_partner_hash_size_status")
  @@index([partyId, status, creTime(sort: Desc)], map: "idx_storage_object_partner_status_time")
  @@index([uploaderUserId], map: "idx_storage_object_uploader")
  @@map("storage_object")
}

// ─── storage_attachment ─────────────────────────────────
model StorageAttachment {
  storageAttachmentId String    @id @default(uuid()) @map("storage_attachment_id")
  partyId            Int       @map("party_id")
  storageObjectId     String    @map("storage_object_id")
  subjectType         String    @map("subject_type") @db.VarChar(64)
  subjectId           String    @map("subject_id") @db.VarChar(128)
  purpose             String    @db.VarChar(64)
  displayName         String?   @map("display_name") @db.VarChar(255)
  sortNo              Int       @default(0) @map("sort_no")
  isPrimary           Boolean   @default(false) @map("is_primary")
  status              String    @default("ACTIVE") @db.VarChar(20)
  creTime             DateTime  @default(now()) @map("cre_time") @db.Timestamp(3)
  creUserId           Int       @default(0) @map("cre_user_id")
  updTime             DateTime  @default(now()) @updatedAt @map("upd_time") @db.Timestamp(3)
  updUserId           Int       @default(0) @map("upd_user_id")
  deletedAt           DateTime? @map("deleted_at") @db.Timestamp(3)

  partner        SysParty     @relation(fields: [partyId], references: [partyId])
  storageObject StorageObject @relation(fields: [storageObjectId], references: [storageObjectId], onDelete: Cascade)

  @@unique([partyId, storageObjectId, subjectType, subjectId, purpose], map: "uk_storage_attachment_object_subject")
  @@index([partyId, subjectType, subjectId, purpose, status, sortNo], map: "idx_storage_attachment_subject")
  @@index([storageObjectId], map: "idx_storage_attachment_object")
  @@index([partyId, status, creTime(sort: Desc)], map: "idx_storage_attachment_partner_status_time")
  @@map("storage_attachment")
}

// ─── sys_operation_log（操作日志，UUID 主键，只写不改）─────────────
// 无 FK：append-only 审计，party_id / operator_user_id 仅冗余存值，不约束。
// result 取值 SUCCESS / FAILURE 由应用层保证（Prisma 不表达 CHECK）。
model SysOperationLog {
  operationLogId   String   @id @default(uuid()) @map("operation_log_id")
  traceId          String   @map("trace_id") @db.VarChar(64)
  operatorUserId   Int?     @map("operator_user_id")
  operatorNickName String   @map("operator_nick_name") @db.VarChar(100)
  operatorIp       String?  @map("operator_ip") @db.VarChar(64)
  partyId          Int      @map("party_id")
  action           String   @db.VarChar(100)
  title            String   @db.VarChar(200)
  detail           Json     @default("{}")
  result           String   @db.VarChar(20)
  failureReason    String?  @map("failure_reason") @db.VarChar(500)
  creTime          DateTime @default(now()) @map("cre_time") @db.Timestamp(3)

  @@index([traceId], map: "idx_sys_operation_log_trace")
  @@index([partyId, creTime(sort: Desc)], map: "idx_sys_operation_log_party_time")
  @@map("sys_operation_log")
}

// ─── sys_notice（站内消息，UUID 主键）─────────────
// payload 按 notice_type 不同载荷不同，必含 summary（取代旧 content，见 notice backend-conflicts 裁决）；status 取值 UNREAD / READ 由应用层保证。
model SysNotice {
  noticeId        String   @id @default(uuid()) @map("notice_id")
  userId          Int      @map("user_id")
  belongToPartyId Int?     @map("belong_to_party_id")
  noticeType      String?  @map("notice_type") @db.VarChar(40)
  title           String?  @db.VarChar(200)
  payload         Json     @default("{}")
  status          String   @default("UNREAD") @db.VarChar(20)
  creTime         DateTime @default(now()) @map("cre_time") @db.Timestamp(3)
  updTime         DateTime @default(now()) @updatedAt @map("upd_time") @db.Timestamp(3)

  user          SysUser   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  belongToParty SysParty? @relation(fields: [belongToPartyId], references: [partyId])

  @@index([userId, status], map: "idx_sys_notice_user")
  @@index([belongToPartyId], map: "idx_sys_notice_party")
  @@map("sys_notice")
}
