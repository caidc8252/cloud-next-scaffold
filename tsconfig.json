{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./packages/ui/src/*"],
      "@cloud/config": ["./packages/config/src/index.ts"],
      "@cloud/db": ["./packages/db/src/index.ts"],
      "@cloud/permissions": ["./packages/permissions/src/index.ts"],
      "@cloud/request": ["./packages/request/src/index.ts"],
      "@cloud/request/server": ["./packages/request/src/server.ts"],
      "@cloud/request/client": ["./packages/request/src/client.ts"],
      "@cloud/security/server": ["./packages/security/src/server/index.ts"],
      "@cloud/ui": ["./packages/ui/src/index.ts"],
      "@cloud/ui/*": ["./packages/ui/src/*"]
    }
  },
  "include": [
    "apps/web/**/*.ts",
    "apps/web/**/*.tsx",
    "apps/web/next-env.d.ts",
    "packages/config/src/**/*.ts",
    "packages/config/test/**/*.ts",
    "packages/db/**/*.ts",
    "packages/permissions/src/**/*.ts",
    "packages/request/src/**/*.ts",
    "packages/security/**/*.ts",
    "packages/ui/src/**/*.ts",
    "packages/ui/src/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
